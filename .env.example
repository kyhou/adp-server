# Copy to .env and fill in. This server reads config via std::env, so export these
# or use `dotenvy`/your process manager — main.rs does not load .env itself.

# This server's own public base URL. MUST exactly match an entry in the `server`
# tags of any listing this instance distributes, and is used to validate the `u`
# tag on inbound NIP-98 auth tokens.
ADP_SERVER_URL=http://localhost:8080

ADP_BIND_ADDR=0.0.0.0:8080
ADP_DB_PATH=./data/adp.db
ADP_FILES_DIR=./data/files
ADP_RELAYS=wss://relay.damus.io,wss://nos.lol

# REQUIRED. bech32 nsec1... or hex secret key for the DEDICATED fulfillment key.
# Generate one specifically for this server instance — never reuse a developer's
# or your own primary identity key here. See ADP-01.md "Security Considerations".
ADP_FULFILLMENT_NSEC=

# Seconds a /purchase/confirm download token remains valid.
ADP_DOWNLOAD_TOKEN_TTL_SECS=900
