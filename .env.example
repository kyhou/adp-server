# Copy to .env and fill in. This server reads config via std::env, so export these
# or use `dotenvy`/your process manager — main.rs does not load .env itself.

# This server's own public base URL. MUST exactly match an entry in the `server`
# tags of any listing this instance distributes, and is used to validate the `u`
# tag on inbound NIP-98 auth tokens.
ADP_SERVER_URL=http://localhost:8080

ADP_BIND_ADDR=0.0.0.0:8080
ADP_DB_PATH=./data/adp.db
ADP_FILES_DIR=./data/files
ADP_RELAYS=wss://relay.damus.io,wss://nos.lol

# REQUIRED. bech32 nsec1... or hex secret key for this operator identity. This key
# signs kind:30403 server announcements and kind:30404 provisioning attestations.
ADP_OPERATOR_NSEC=

# REQUIRED. 32 raw bytes encoded as 64 hex characters. This encrypts provisioned
# fulfillment private keys at rest. Production operators should evaluate HSM/KMS.
ADP_MASTER_KEY=

# Local/dev testing only. Has no effect on non-loopback domains regardless of this setting.
ADP_ALLOW_INSECURE_LNURL=false

# Seconds a /purchase/confirm download token remains valid.
ADP_DOWNLOAD_TOKEN_TTL_SECS=900

# Seconds between background SHA-256 re-verification passes over stored files.
ADP_FILE_REVERIFY_INTERVAL_SECS=3600
